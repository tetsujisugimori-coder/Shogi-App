{
  "name": "shogi-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "verify:lock": "node scripts/verify-lockfile.mjs",
    "verify:macos-fsevents": "node scripts/verify-macos-fsevents.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run verify:lock && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@google/genai": false,
    "esbuild": true,
    "fsevents": false,
    "protobufjs": false
  }
}
