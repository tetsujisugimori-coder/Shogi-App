{
  "name": "shogi-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "verify:lock": "node scripts/verify-lockfile.mjs",
    "verify:macos-fsevents": "node scripts/verify-macos-fsevents.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "measure:quiescence-suite": "tsx scripts/measure-quiescence-suite.ts",
    "measure:quiescence-ordering": "tsx scripts/measure-quiescence-ordering.ts",
    "measure:quiescence-ordering-repeated": "tsx scripts/measure-quiescence-ordering-repeated.ts",
    "measure:quiescence-ordering-self-play": "tsx scripts/measure-quiescence-ordering-self-play.ts",
    "measure:quiescence-ordering-self-play-suite": "tsx scripts/measure-quiescence-ordering-self-play-suite.ts",
    "measure:quiescence-ordering-suite-comparison": "tsx scripts/measure-quiescence-ordering-suite-comparison.ts",
    "measure:killer-move-suite-comparison": "tsx scripts/measure-killer-move-suite-comparison.ts",
    "measure:time-limit-stress": "tsx scripts/measure-time-limit-stress.ts",
    "measure:timed-fallback-self-play": "tsx scripts/measure-timed-fallback-self-play.ts",
    "measure:timed-depth-one": "tsx scripts/measure-timed-depth-one-diagnostics.ts",
    "audit:timed-depth-one": "tsx scripts/audit-timed-depth-one-diagnostics.ts",
    "measure:timed-long-tail": "tsx scripts/measure-timed-long-tail.ts",
    "audit:timed-long-tail": "tsx scripts/audit-timed-long-tail.ts",
    "measure:root-legal-breakdown": "tsx scripts/measure-root-legal-breakdown.ts",
    "measure:root-legal-context": "tsx scripts/measure-root-legal-context.ts",
    "audit:root-legal-context": "tsx scripts/audit-root-legal-context.ts",
    "audit:root-legal-breakdown": "tsx scripts/audit-root-legal-breakdown.ts",
    "measure:post-root-depth-one": "tsx scripts/measure-post-root-depth-one.ts",
    "audit:post-root-depth-one": "tsx scripts/audit-post-root-depth-one.ts",
    "measure:q-legal-breakdown": "tsx scripts/measure-quiescence-legal-breakdown.ts",
    "audit:q-legal-breakdown": "tsx scripts/audit-quiescence-legal-breakdown.ts",
    "measure:check-internals": "tsx scripts/measure-check-internals.ts",
    "audit:check-internals": "tsx scripts/audit-check-internals.ts",
    "measure:check-shortcircuit-fixed": "tsx scripts/measure-check-shortcircuit-fixed.ts",
    "audit:check-shortcircuit": "tsx scripts/compare-check-shortcircuit.ts",
    "audit:timed-fallback-self-play": "tsx scripts/audit-timed-fallback-self-play.ts",
    "check": "npm run verify:lock && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@google/genai": false,
    "esbuild": true,
    "fsevents": false,
    "protobufjs": false
  }
}
